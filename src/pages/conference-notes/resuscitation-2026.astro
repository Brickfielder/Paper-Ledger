---
import BaseLayout from "../../layouts/BaseLayout.astro";
import notesSource from "../../data/resuscitation-2026-notes.html?raw";

---

<BaseLayout
  title="Resuscitation 2026 Notes | Paper Ledger"
  description="Notes from the European Resuscitation Council Congress, Resuscitation 2026, Milan, 18–19 September 2026."
>
  <article class="conference-notes">
    <header class="conference-notes__hero">
      <p class="eyebrow">ERC Congress · Resuscitation 2026 · Milan</p>
      <h1 class="page-title">Conference notes</h1>
      <p class="page-intro">
        Selected notes taken on 18–19 September 2026 at Allianz MiCo, Milan, Italy.
        The ERC programme gives the overall congress dates as 17–19 September.
      </p>
      <dl class="conference-notes__stats">
        <div><dt>Notes</dt><dd>3</dd></div>
        <div><dt>Conference days</dt><dd>2</dd></div>
        <div><dt>Format</dt><dd>Searchable notes</dd></div>
      </dl>
    </header>

    <div class="conference-toolbar" role="search">
      <label class="conference-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.7-3.7"></path>
        </svg>
        <input
          id="searchInput"
          type="search"
          placeholder="Search speakers, topics, or notes"
          aria-label="Search conference notes"
        />
      </label>
      <button id="expandAll" type="button">Expand all</button>
      <button id="collapseAll" type="button">Collapse all</button>
    </div>

    <p class="conference-notes__notice">
      <strong>About these notes.</strong> Personal presentation summaries; findings and
      clinical suggestions are reported from the talks and have not been independently
      verified. Recorded timestamps are not confirmed session times. Some names, study
      details, and citations were unclear in the source notes and remain explicitly marked
      for verification. These are selected notes, not complete proceedings.
    </p>

    <div class="conference-days" set:html={notesSource} />
    <p class="conference-empty" id="emptyState" hidden>No presentations match that search.</p>
  </article>
</BaseLayout>

<script is:inline>
  const notes = [...document.querySelectorAll(".note-card")];
  const sections = [...document.querySelectorAll(".day-section")];
  const input = document.getElementById("searchInput");
  const empty = document.getElementById("emptyState");

  const applySearch = () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;

    for (const note of notes) {
      const show = !query || note.dataset.search.includes(query);
      note.hidden = !show;
      if (show) visible += 1;
    }

    for (const section of sections) {
      section.hidden = ![...section.querySelectorAll(".note-card")].some((note) => !note.hidden);
    }

    empty.hidden = visible !== 0;
  };

  input.addEventListener("input", applySearch);
  document.getElementById("expandAll").addEventListener("click", () => {
    notes.filter((note) => !note.hidden).forEach((note) => (note.open = true));
  });
  document.getElementById("collapseAll").addEventListener("click", () => {
    notes.forEach((note) => (note.open = false));
  });

  let printState = [];
  window.addEventListener("beforeprint", () => {
    printState = notes.map((note) => note.open);
    notes.forEach((note) => (note.open = true));
  });
  window.addEventListener("afterprint", () => {
    notes.forEach((note, index) => (note.open = printState[index]));
  });
</script>
